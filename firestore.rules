rules_version = '2';

// ============================================================================
// ZEROONE MARASEM — Firestore Security Rules
//
// Data model:
//   /admins/{uid}          -> { role, name, email, createdAt }  (managed manually,
//                              or by an existing admin; never client-writable)
//   /guests/{invitationToken} -> full guest record. The document ID IS the
//                              invitation token (long, random, unguessable),
//                              NOT a sequential/auto Firestore ID. This lets a
//                              guest fetch exactly one document by an exact,
//                              unguessable key with zero ability to list or
//                              enumerate other guests.
//   /auditLogs/{logId}     -> append-only admin activity log.
//
// Roles (stored in /admins/{uid}.role):
//   admin   -> full access
//   manager -> guest management, delivery, analytics, check-in
//   staff   -> check-in + search + read guests
//   viewer  -> read-only analytics/guests
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Role helpers -------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function role() {
      return adminDoc().data.role;
    }

    function hasRole(roles) {
      return isAdminUser() && (role() in roles);
    }

    // Full read/write staff
    function canManageGuests() {
      return hasRole(['admin', 'manager']);
    }

    // Check-in + search + read
    function canCheckIn() {
      return hasRole(['admin', 'manager', 'staff']);
    }

    // Read-only
    function canView() {
      return hasRole(['admin', 'manager', 'staff', 'viewer']);
    }

    function isAdminOnly() {
      return hasRole(['admin']);
    }

    // ---- /admins --------------------------------------------------------
    // Role assignment is never done from the client. Create/edit admin docs
    // from the Firebase console (or a trusted server) only.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isAdminOnly();
      allow write: if false;
    }

    // ---- /guests ----------------------------------------------------------
    // PRIVATE guest record. Contact data (phone/email) lives here and is
    // never publicly readable. Admin roles can read/write it. Guests may
    // update only the narrow tracking/RSVP fields, without being allowed to
    // read the private document.
    match /guests/{token} {
      allow get: if canView();
      allow list: if canView();

      allow create: if canManageGuests();
      allow delete: if isAdminOnly();
      allow update: if canManageGuests();

      // Check-in team can only transition checkedIn false -> true.
      allow update: if canCheckIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['checkedIn', 'checkedInAt', 'updatedAt']) &&
        resource.data.checkedIn != true &&
        request.resource.data.checkedIn == true &&
        request.resource.data.checkedInAt is timestamp;

      // Public invitation client: write-only tracking/RSVP updates.
      // It cannot read this private document or modify contact/event data.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['opened', 'openedAt', 'pageViewedAt',
                    'rsvpStatus', 'confirmed', 'confirmedAt']) &&
        (
          !('opened' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (resource.data.opened != true && request.resource.data.opened == true)
        ) &&
        (
          !('openedAt' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (resource.data.opened != true && request.resource.data.opened == true && request.resource.data.openedAt is timestamp)
        ) &&
        (
          !('pageViewedAt' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.pageViewedAt is timestamp
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rsvpStatus', 'confirmed', 'confirmedAt']) ||
          (
            resource.data.rsvpStatus == 'pending' &&
            request.resource.data.rsvpStatus in ['confirmed', 'declined'] &&
            (
              (request.resource.data.rsvpStatus == 'confirmed' &&
               request.resource.data.confirmed == true &&
               request.resource.data.confirmedAt is timestamp) ||
              (request.resource.data.rsvpStatus == 'declined' &&
               request.resource.data.confirmed == false)
            )
          )
        );
    }

    // ---- /publicGuests ----------------------------------------------------
    // Minimal public projection used by invitation.html. Deliberately omits
    // phone, email, audit data and other private fields. The invitation URL
    // token remains the capability needed to read exactly one document.
    match /publicGuests/{token} {
      allow get: if true;
      allow list: if false;

      // Only the admin dashboard can create/maintain the public projection.
      allow create, delete: if canManageGuests();
      allow update: if canManageGuests();

      // Guest browser may record only monotonic tracking/RSVP state.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['opened', 'openedAt', 'pageViewedAt',
                    'rsvpStatus', 'confirmed', 'confirmedAt']) &&
        (
          !('opened' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (resource.data.opened != true && request.resource.data.opened == true)
        ) &&
        (
          !('openedAt' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (resource.data.opened != true && request.resource.data.opened == true && request.resource.data.openedAt is timestamp)
        ) &&
        (
          !('pageViewedAt' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.pageViewedAt is timestamp
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rsvpStatus', 'confirmed', 'confirmedAt']) ||
          (
            resource.data.rsvpStatus == 'pending' &&
            request.resource.data.rsvpStatus in ['confirmed', 'declined'] &&
            (
              (request.resource.data.rsvpStatus == 'confirmed' &&
               request.resource.data.confirmed == true &&
               request.resource.data.confirmedAt is timestamp) ||
              (request.resource.data.rsvpStatus == 'declined' &&
               request.resource.data.confirmed == false)
            )
          )
        );
    }

    // ---- /auditLogs ---------------------------------------------------
    // Append-only. Never editable or deletable by anyone, including admins.
    match /auditLogs/{logId} {
      allow read: if canView();
      allow create: if canCheckIn() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.action in ['created', 'updated', 'deleted', 'deliveryPrepared', 'rsvpUpdated', 'checkedIn'] &&
        request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
